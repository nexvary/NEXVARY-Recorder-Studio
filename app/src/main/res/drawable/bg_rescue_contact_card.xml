<?xml version="1.0" encoding="utf-8"?>
<!-- A bright 2dp neon core with two restrained halo rings; the interior stays glossy black. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#2043FF88">
 <item><layer-list>
  <item><shape><corners android:radius="23dp"/><solid android:color="#2043FF88"/></shape></item>
  <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp"><shape><corners android:radius="22dp"/><solid android:color="#8043FF88"/></shape></item>
  <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp"><shape><corners android:radius="21dp"/><solid android:color="#43FF88"/></shape></item>
  <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp"><shape><corners android:radius="19dp"/><gradient android:angle="315" android:startColor="#10271C" android:centerColor="#0A0A0A" android:endColor="#090E0C"/></shape></item>
  <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp"><shape><corners android:radius="18dp"/><gradient android:angle="270" android:startColor="#16FFFFFF" android:endColor="#00FFFFFF"/></shape></item>
 </layer-list></item>
</ripple>
