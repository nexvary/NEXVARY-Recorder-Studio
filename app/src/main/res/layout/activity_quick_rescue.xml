<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@drawable/bg_piano_gloss">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
 <Button android:id="@+id/btnBack" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/back"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/rescue_heading" android:textColor="#FFFFFF" android:textSize="23sp" android:textStyle="bold" android:layout_marginBottom="18dp"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="22dp" android:background="@drawable/bg_sos_card">
  <ImageView android:layout_width="88dp" android:layout_height="88dp" android:src="@drawable/asset_sos" android:scaleType="fitCenter" android:importantForAccessibility="no"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/rescue_hero_title" android:textColor="#FF7A85" android:textSize="23sp" android:textStyle="bold" android:gravity="center"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/rescue_hero_note" android:textColor="#E1DDE1" android:textSize="15sp" android:gravity="center"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_rescue_contact_card">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/rescue_contacts" android:textSize="21sp" android:textColor="#FFFFFF" android:textStyle="bold"/>
  <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnAddContact" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/rescue_add" android:layout_marginTop="12dp" android:background="@drawable/bg_rescue_contact_card" app:backgroundTint="@null" android:textColor="#43FF88" android:textAllCaps="false" android:minHeight="52dp"/>
  <LinearLayout android:id="@+id/contactList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
 </LinearLayout>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="16dp" android:text="@string/rescue_attachments" android:textColor="#D3DCE5" android:textSize="14sp"/>
 <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnPrepareRescue" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:padding="12dp" android:background="@drawable/bg_sos_button" android:backgroundTint="@null" app:backgroundTint="@null" android:text="@string/rescue_prepare" android:textColor="#FFFFFF" android:textSize="19sp" android:textAllCaps="false"/>
</LinearLayout></ScrollView>