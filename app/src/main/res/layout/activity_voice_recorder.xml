<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="20dp" android:background="?attr/nexvaryBackground" android:layoutDirection="rtl">
    <Button android:id="@+id/btnBack" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="رجوع" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
        android:text="استوديو الصوت الاحترافي" android:textColor="?attr/nexvaryText" android:textStyle="bold" android:textSize="24sp" android:gravity="end" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:text="48 kHz PCM مع Noise Suppression وAGC وEcho Cancellation عند دعم الهاتف، ثم تحسين/تطبيع للصوت." android:textColor="?attr/nexvaryMuted" android:gravity="end" />
    <TextView android:id="@+id/txtStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="جاهز" android:textColor="?attr/nexvaryMuted" android:gravity="end" />
    <Button android:id="@+id/btnRecord" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="20dp" android:text="ابدأ تسجيل الصوت" />
    <Button android:id="@+id/btnStop" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="12dp" android:text="إيقاف + تحسين" android:enabled="false" />
    <TextView android:id="@+id/txtOutput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:textColor="?attr/nexvaryAccent" android:gravity="end" />
</LinearLayout>
