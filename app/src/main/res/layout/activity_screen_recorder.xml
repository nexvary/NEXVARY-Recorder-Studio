<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/nexvaryBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <Button android:id="@+id/btnBack" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/back" />
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            app:cardBackgroundColor="?attr/nexvarySurfaceStrong" app:cardCornerRadius="22dp" app:strokeColor="?attr/nexvaryAccent" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <View android:id="@+id/recordingIndicator" android:layout_width="14dp" android:layout_height="14dp" android:background="@drawable/record_dot" android:visibility="gone" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="@string/screen_record_title" android:textColor="?attr/nexvaryText" android:textSize="23sp" android:textStyle="bold" android:gravity="start" android:textDirection="locale" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/screen_full_desc" android:textColor="?attr/nexvaryMuted" android:textSize="13sp" android:gravity="start" android:textDirection="locale" />
                <TextView android:id="@+id/txtStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/ready" android:textColor="?attr/nexvaryAccent" android:textStyle="bold" android:gravity="start" android:textDirection="locale" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            app:cardBackgroundColor="?attr/nexvarySurface" app:cardCornerRadius="18dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <CheckBox android:id="@+id/checkMic" android:layout_width="match_parent" android:layout_height="wrap_content" android:checked="true" android:text="@string/record_mic" android:textColor="?attr/nexvaryText" android:gravity="start" android:textDirection="locale" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/auto_resolution_desc" android:textColor="?attr/nexvaryMuted" android:textSize="12sp" android:gravity="start" android:textDirection="locale" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <Button android:id="@+id/btnStart" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="16dp" android:text="@string/start_screen" />
        <Button android:id="@+id/btnStop" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="10dp" android:text="@string/stop_save" android:enabled="false" />
        <TextView android:id="@+id/txtOutput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:layout_marginBottom="18dp" android:textColor="?attr/nexvaryMuted" android:gravity="start" android:textDirection="locale" />
    </LinearLayout>
</ScrollView>