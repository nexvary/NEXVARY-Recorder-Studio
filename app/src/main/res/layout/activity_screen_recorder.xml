<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/nexvaryBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/back" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="?attr/nexvarySurfaceStrong"
            app:cardCornerRadius="22dp"
            app:strokeColor="?attr/nexvaryAccent"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/recordingIndicator"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:background="@drawable/record_dot"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="@string/screen_record_title"
                        android:textColor="?attr/nexvaryText"
                        android:textSize="23sp"
                        android:textStyle="bold"
                        android:gravity="start"
                        android:textDirection="locale" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/ready"
                    android:textColor="?attr/nexvaryAccent"
                    android:textStyle="bold"
                    android:gravity="start"
                    android:textDirection="locale" />

                <TextView
                    android:id="@+id/txtOutput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="?attr/nexvaryMuted"
                    android:gravity="start"
                    android:textDirection="locale" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="?attr/nexvarySurface"
            app:cardCornerRadius="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/recorder_options"
                    android:textColor="?attr/nexvaryText"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:gravity="start"
                    android:textDirection="locale" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchMic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:checked="true"
                    android:text="@string/record_mic"
                    android:textColor="?attr/nexvaryText" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchFloating"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/floating_control"
                    android:textColor="?attr/nexvaryText" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchTouches"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/show_touches"
                    android:textColor="?attr/nexvaryText" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchCamera"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/camera_overlay"
                    android:textColor="?attr/nexvaryText" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/countdown_title"
                    android:textColor="?attr/nexvaryText"
                    android:textStyle="bold"
                    android:gravity="start"
                    android:textDirection="locale" />

                <RadioGroup
                    android:id="@+id/groupCountdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:gravity="start">

                    <RadioButton
                        android:id="@+id/radio0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/countdown_0"
                        android:textColor="?attr/nexvaryText" />

                    <RadioButton
                        android:id="@+id/radio3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/countdown_3"
                        android:textColor="?attr/nexvaryText" />

                    <RadioButton
                        android:id="@+id/radio5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/countdown_5"
                        android:textColor="?attr/nexvaryText" />

                    <RadioButton
                        android:id="@+id/radio10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/countdown_10"
                        android:textColor="?attr/nexvaryText" />
                </RadioGroup>

                <Button
                    android:id="@+id/btnStorage"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/choose_save_folder" />

                <TextView
                    android:id="@+id/txtStorage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/default_save_folder"
                    android:textColor="?attr/nexvaryMuted"
                    android:textSize="12sp"
                    android:gravity="start"
                    android:textDirection="locale" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/save_folder_help"
                    android:textColor="?attr/nexvaryMuted"
                    android:textSize="11sp"
                    android:gravity="start"
                    android:textDirection="locale" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="?attr/nexvarySurfaceStrong"
            app:cardCornerRadius="18dp"
            app:strokeColor="?attr/nexvaryAccent"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <Button
                    android:id="@+id/btnRecordFgLink"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/record_fg_link" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/record_fg_link_help"
                    android:textColor="?attr/nexvaryMuted"
                    android:textSize="11sp"
                    android:gravity="start"
                    android:textDirection="locale" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:text="@string/start_screen" />

        <Button
            android:id="@+id/btnPauseResume"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="@string/pause_recording"
            android:enabled="false" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="18dp"
            android:text="@string/stop_save"
            android:enabled="false" />
    </LinearLayout>
</ScrollView>
