<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/nexvaryBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/themeHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="?attr/nexvarySurfaceStrong"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:strokeColor="?attr/nexvaryAccent"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@mipmap/ic_launcher"
                    android:contentDescription="@string/app_name" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="?attr/nexvaryText"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:gravity="start"
                        android:textDirection="locale" />

                    <TextView
                        android:id="@+id/txtVersion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/version_format"
                        android:textColor="?attr/nexvaryMuted"
                        android:textSize="11sp"
                        android:gravity="start"
                        android:textDirection="locale" />

                    <TextView
                        android:id="@+id/txtThemeName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/theme_hint"
                        android:textColor="?attr/nexvaryAccent"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="start"
                        android:textDirection="locale" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/home_subtitle"
            android:textColor="?attr/nexvaryMuted"
            android:textSize="14sp"
            android:gravity="start"
            android:textDirection="locale" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="10dp"
            android:text="@string/studio_tools"
            android:textColor="?attr/nexvaryText"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="start"
            android:textDirection="locale" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardScreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="?attr/nexvarySurface"
            app:cardCornerRadius="18dp"
            app:strokeColor="?attr/nexvaryAccent"
            app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="8dp" android:src="@drawable/ic_feature_screen" android:contentDescription="@string/screen_record_title" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/screen_record_title" android:textColor="?attr/nexvaryText" android:textStyle="bold" android:textSize="18sp" android:gravity="start" android:textDirection="locale" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/screen_record_desc" android:textColor="?attr/nexvaryMuted" android:textSize="12sp" android:gravity="start" android:textDirection="locale" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardVoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="?attr/nexvarySurface"
            app:cardCornerRadius="18dp"
            app:strokeColor="?attr/nexvaryAccent"
            app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="8dp" android:src="@drawable/ic_feature_mic" android:contentDescription="@string/voice_studio_title" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/voice_studio_title" android:textColor="?attr/nexvaryText" android:textStyle="bold" android:textSize="18sp" android:gravity="start" android:textDirection="locale" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/voice_studio_desc" android:textColor="?attr/nexvaryMuted" android:textSize="12sp" android:gravity="start" android:textDirection="locale" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardReplace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="?attr/nexvarySurface"
            app:cardCornerRadius="18dp"
            app:strokeColor="?attr/nexvaryAccent"
            app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="8dp" android:src="@drawable/ic_feature_audio" android:contentDescription="@string/replace_audio_title" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/replace_audio_title" android:textColor="?attr/nexvaryText" android:textStyle="bold" android:textSize="18sp" android:gravity="start" android:textDirection="locale" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/replace_audio_desc" android:textColor="?attr/nexvaryMuted" android:textSize="12sp" android:gravity="start" android:textDirection="locale" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="?attr/nexvarySurface"
            app:cardCornerRadius="18dp"
            app:strokeColor="?attr/nexvaryAccent"
            app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="8dp" android:src="@drawable/ic_feature_live" android:contentDescription="@string/live_title" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/live_title" android:textColor="?attr/nexvaryText" android:textStyle="bold" android:textSize="18sp" android:gravity="start" android:textDirection="locale" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/live_desc" android:textColor="?attr/nexvaryMuted" android:textSize="12sp" android:gravity="start" android:textDirection="locale" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="?attr/nexvarySurface"
            app:cardCornerRadius="18dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="8dp" android:src="@drawable/ic_feature_language" android:contentDescription="@string/language_title" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/language_title" android:textColor="?attr/nexvaryText" android:textStyle="bold" android:textSize="18sp" android:gravity="start" android:textDirection="locale" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/language_desc" android:textColor="?attr/nexvaryMuted" android:textSize="12sp" android:gravity="start" android:textDirection="locale" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="?attr/nexvarySurface"
            app:cardCornerRadius="18dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="8dp" android:src="@drawable/ic_feature_info" android:contentDescription="@string/about_title" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/about_title" android:textColor="?attr/nexvaryText" android:textStyle="bold" android:textSize="18sp" android:gravity="start" android:textDirection="locale" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/about_desc" android:textColor="?attr/nexvaryMuted" android:textSize="12sp" android:gravity="start" android:textDirection="locale" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:text="@string/privacy_footer"
            android:textColor="?attr/nexvaryMuted"
            android:textSize="12sp"
            android:gravity="center"
            android:textDirection="locale" />
    </LinearLayout>
</ScrollView>