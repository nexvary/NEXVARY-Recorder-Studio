<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/nexvaryBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <Button android:id="@+id/btnBack" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/back" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/language_page_title" android:textColor="?attr/nexvaryText" android:textSize="24sp" android:textStyle="bold" android:gravity="start" android:textDirection="locale" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/language_help" android:textColor="?attr/nexvaryMuted" android:textSize="14sp" android:gravity="start" android:textDirection="locale" />
        <Button android:id="@+id/btnSystem" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="16dp" android:text="@string/system_default" />
        <Button android:id="@+id/btnArabic" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:text="@string/lang_arabic" />
        <Button android:id="@+id/btnEnglish" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:text="@string/lang_english" />
        <Button android:id="@+id/btnTurkish" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:text="@string/lang_turkish" />
        <Button android:id="@+id/btnSpanish" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:text="@string/lang_spanish" />
        <Button android:id="@+id/btnGerman" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:text="@string/lang_german" />
        <Button android:id="@+id/btnItalian" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:text="@string/lang_italian" />
        <Button android:id="@+id/btnFrench" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:text="@string/lang_french" />
        <Button android:id="@+id/btnUrdu" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:text="@string/lang_urdu" />
        <Button android:id="@+id/btnPersian" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:text="@string/lang_persian" />
        <Button android:id="@+id/btnRussian" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:layout_marginBottom="18dp" android:text="@string/lang_russian" />
    </LinearLayout>
</ScrollView>