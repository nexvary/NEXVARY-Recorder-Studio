<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/nexvaryBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <Button android:id="@+id/btnBack" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/back" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/replace_page_title" android:textColor="?attr/nexvaryText" android:textSize="23sp" android:textStyle="bold" android:gravity="start" android:textDirection="locale" />
        <Button android:id="@+id/btnVideo" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp" android:text="@string/choose_video" />
        <TextView android:id="@+id/txtVideo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="@string/no_video_selected" android:textColor="?attr/nexvaryMuted" android:gravity="start" android:textDirection="locale" />
        <Button android:id="@+id/btnAudio" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:text="@string/choose_audio" />
        <TextView android:id="@+id/txtAudio" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="?attr/nexvaryMuted" android:gravity="start" android:textDirection="locale" />
        <Button android:id="@+id/btnMerge" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="16dp" android:text="@string/create_video" />
        <TextView android:id="@+id/txtStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:layout_marginBottom="18dp" android:textColor="?attr/nexvaryAccent" android:gravity="start" android:textDirection="locale" />
    </LinearLayout>
</ScrollView>