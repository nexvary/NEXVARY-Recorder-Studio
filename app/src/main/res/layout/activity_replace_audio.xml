<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="20dp" android:background="?attr/nexvaryBackground" android:layoutDirection="rtl">
    <Button android:id="@+id/btnBack" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="رجوع" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="استبدال صوت الفيديو" android:textColor="?attr/nexvaryText" android:textSize="24sp" android:textStyle="bold" android:gravity="end" />
    <Button android:id="@+id/btnVideo" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="20dp" android:text="اختر الفيديو" />
    <TextView android:id="@+id/txtVideo" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="?attr/nexvaryMuted" android:gravity="end" />
    <Button android:id="@+id/btnAudio" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="14dp" android:text="اختر الصوت المحسن (WAV/M4A/AAC)" />
    <TextView android:id="@+id/txtAudio" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="?attr/nexvaryMuted" android:gravity="end" />
    <Button android:id="@+id/btnMerge" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="20dp" android:text="إنشاء الفيديو بالصوت الجديد" />
    <TextView android:id="@+id/txtStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textColor="?attr/nexvaryAccent" android:gravity="end" />
</LinearLayout>
