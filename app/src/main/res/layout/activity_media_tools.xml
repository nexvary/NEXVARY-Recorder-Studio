<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/nexvaryBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/back" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/media_tools_title"
            android:textColor="?attr/nexvaryText"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="start"
            android:textDirection="locale" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/media_tools_desc"
            android:textColor="?attr/nexvaryMuted"
            android:gravity="start"
            android:textDirection="locale" />

        <Button
            android:id="@+id/btnReplaceAudio"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:text="@string/replace_audio_title" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="?attr/nexvarySurface"
            app:cardCornerRadius="18dp"
            app:strokeColor="?attr/nexvaryAccent"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/audio_convert_title"
                    android:textColor="?attr/nexvaryText"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="start"
                    android:textDirection="locale" />

                <Button
                    android:id="@+id/btnChooseAudio"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/choose_audio" />

                <TextView
                    android:id="@+id/txtAudioFile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/no_audio_selected"
                    android:textColor="?attr/nexvaryMuted"
                    android:gravity="start"
                    android:textDirection="locale" />

                <Spinner
                    android:id="@+id/spinnerAudioFormat"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp" />

                <Button
                    android:id="@+id/btnConvertAudio"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/convert_audio" />

                <TextView
                    android:id="@+id/txtAudioStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="?attr/nexvaryAccent"
                    android:gravity="start"
                    android:textDirection="locale" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="?attr/nexvarySurface"
            app:cardCornerRadius="18dp"
            app:strokeColor="?attr/nexvaryAccent"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/video_tools_title"
                    android:textColor="?attr/nexvaryText"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="start"
                    android:textDirection="locale" />

                <Button
                    android:id="@+id/btnChooseVideo"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/choose_video" />

                <TextView
                    android:id="@+id/txtVideoFile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/no_video_selected"
                    android:textColor="?attr/nexvaryMuted"
                    android:gravity="start"
                    android:textDirection="locale" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:hint="@string/trim_start_seconds">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputTrimStart"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:textDirection="ltr" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:hint="@string/trim_end_seconds">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputTrimEnd"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:textDirection="ltr" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btnTrimVideo"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/trim_video" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/video_convert_title"
                    android:textColor="?attr/nexvaryText"
                    android:textStyle="bold"
                    android:gravity="start"
                    android:textDirection="locale" />

                <Spinner
                    android:id="@+id/spinnerVideoFormat"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp" />

                <Button
                    android:id="@+id/btnConvertVideo"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/convert_video" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/video_convert_note"
                    android:textColor="?attr/nexvaryMuted"
                    android:textSize="11sp"
                    android:gravity="start"
                    android:textDirection="locale" />

                <TextView
                    android:id="@+id/txtVideoStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="6dp"
                    android:textColor="?attr/nexvaryAccent"
                    android:gravity="start"
                    android:textDirection="locale" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
