<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/nexvaryBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <Button android:id="@+id/btnBack" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/back" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/about_page_title" android:textColor="?attr/nexvaryText" android:textSize="24sp" android:textStyle="bold" android:gravity="start" android:textDirection="locale" />
        <TextView android:id="@+id/txtVersion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/version_format" android:textColor="?attr/nexvaryAccent" android:gravity="start" android:textDirection="locale" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/about_body" android:textColor="?attr/nexvaryMuted" android:textSize="14sp" android:lineSpacingExtra="3dp" android:gravity="start" android:textDirection="locale" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="@string/official_links" android:textColor="?attr/nexvaryText" android:textSize="18sp" android:textStyle="bold" android:gravity="start" android:textDirection="locale" />
        <Button android:id="@+id/btnWebsite" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:text="@string/website" />
        <Button android:id="@+id/btnFacebook" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:text="@string/facebook" />
        <Button android:id="@+id/btnEmail" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:text="@string/email" />
        <Button android:id="@+id/btnYoutube" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:text="@string/youtube" />
        <Button android:id="@+id/btnX" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:layout_marginBottom="18dp" android:text="@string/x_social" />
    </LinearLayout>
</ScrollView>