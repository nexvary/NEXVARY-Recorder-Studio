<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
<uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <queries>
        <package android:name="com.kitsumed.shizucallrecorder" />
        <package android:name="moe.shizuku.privileged.api" />
    </queries>
    <application
        android:name=".family.RecorderApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.NexvaryRecorder.PianoBlack">

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <activity android:name=".family.FamilyDashboardActivity" android:exported="false" />
        <activity android:name=".family.FamilySettingsActivity" android:exported="false" />
        <activity android:name=".family.TrustedContactsActivity" android:exported="false" />
        <activity android:name=".family.EmergencyProfileActivity" android:exported="false" />
        <activity android:name=".family.ParentSettingsActivity" android:exported="false" />
        <activity android:name=".family.SafetyQueueActivity" android:exported="false" />
        <activity android:name=".family.SafetyHistoryActivity" android:exported="false" />
        <activity android:name=".family.EvidenceActivity" android:exported="false" />
        <activity android:name=".family.PrivacyCenterActivity" android:exported="false" />
        <activity android:name=".billing.SubscriptionActivity" android:exported="false" />
        <service android:name=".family.AudioEvidenceService" android:exported="false" android:foregroundServiceType="microphone" />
        <service android:name=".family.SafetyLocationService" android:exported="false" android:foregroundServiceType="location" />
        <receiver android:name=".family.SafetyActionReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <service android:name=".family.SafetySosTile" android:exported="true" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" android:icon="@drawable/ic_feature_screen" android:label="@string/fs_sos">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <receiver android:name=".family.SafetySosWidget" android:exported="false" android:label="@string/fs_sos">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/safety_widget" />
        </receiver>
        <activity android:name=".safety.QuickRescueActivity" android:exported="false" />
        <activity android:name=".safety.SafetyCaptureActivity" android:exported="false" />
        <activity android:name=".calls.CallRecorderActivity" android:exported="false" />
        <activity android:name=".camera.BackgroundCameraActivity" android:exported="false" />
        <service android:name=".camera.BackgroundCameraService" android:exported="false" android:foregroundServiceType="camera|microphone" />
        <activity android:name=".guardian.CloudSettingsActivity" android:exported="false" />
        <activity android:name=".guardian.ChildHomeActivity" android:exported="false" />
        <activity android:name=".guardian.GuardianEmergencyActivity" android:exported="false" />
        <activity android:name=".family.FamilyHubActivity" android:exported="false" />
        <activity android:name=".media.VideoCompressionActivity" android:exported="false" />
        <activity android:name=".media.MediaCenterActivity" android:exported="false" />
        <activity android:name=".AboutActivity" android:exported="false" />
        <activity android:name=".LanguageActivity" android:exported="false" />
        <activity android:name=".live.LiveBroadcastActivity" android:exported="false" />
        <activity android:name=".media.MediaToolsActivity" android:exported="false" />
        <activity android:name=".media.AudioReplaceActivity" android:exported="false" />
        <activity android:name=".audio.VoiceRecorderActivity" android:exported="false" />
        <activity android:name=".screen.ScreenRecorderActivity" android:exported="false" />

        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <service
            android:name=".live.LiveBroadcastService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name=".screen.ScreenRecordService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone|camera" />

        <service
            android:name=".screen.RecorderTileService"
            android:exported="true"
            android:icon="@drawable/ic_feature_screen"
            android:label="@string/quick_record_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.files" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/recording_paths"/>
        </provider>
        <activity android:name=".delivery.SmtpSettingsActivity" android:exported="false" />
        <activity android:name=".delivery.MailOutboxActivity" android:exported="false" />
        <activity android:name=".SettingsActivity" android:exported="false"/>
        <activity android:name=".media.RecordingsLibraryActivity" android:exported="false"/>
        <activity android:name=".media.InternalPlayerActivity" android:exported="false" />
        <activity android:name=".family.GuidedSetupActivity" android:exported="false" />
        <activity android:name=".MoreActivity" android:exported="false" />
        <activity android:name=".GuideActivity" android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
